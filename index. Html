await base44.entities.Kegiatan.update(editing.id, payload);
} else {
await base44.entities.Kegiatan.create(payload);
}
setEditing(null);
load();
} catch (err) {
alert("Gagal menyimpan: " + (err?.message || "error"));
} finally {
setSaving(false);
}
};

const handleDelete = async (id, nama) => {
if (!window.confirm(`Hapus kegiatan "${nama}"?`)) return;
await base44.entities.Kegiatan.delete(id);
load();
