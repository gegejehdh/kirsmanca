import moment from "moment";
import "moment/locale/id";
import { base44 } from "@/api/base44Client";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import {
Select,
SelectTrigger,
SelectValue,
SelectContent,
SelectItem,
} from "@/components/ui/select";
import { KELAS_OPTIONS } from "@/lib/kir-constants";

moment.locale("id");

export default function AdminPendaftar() {
const navigate = useNavigate();
const [items, setItems] = useState([]);
const [loading, setLoading] = useState(true);
const [search, setSearch] = useState("");
const [kelasFilter, setKelasFilter] = useState("all");
const [sortBy, setSortBy] = useState("-created_date");

const load = useCallback(() => {
setLoading(true);
const query = {};
if (search.trim()) query.nama = { $regex: search.trim(), $options: "i" };
if (kelasFilter !== "all") query.kelas = kelasFilter;
base44.entities.Pendaftar
.filter(query, { sort: sortBy, limit: 500 })
.then((page) => setItems(page.items || []))
.catch(() => setItems([]))
.finally(() => setLoading(false));
}, [search, kelasFilter, sortBy]);

useEffect(() => {
const t = setTimeout(load, 250);
return () => clearTimeout(t);
}, [load]);

const handleDelete = async (id, nama) => {
if (!window.confirm(`Hapus data pendaftar "${nama}"? Tindakan ini tidak dapat dibatalkan.`)) return;
try {
await base44.entities.Pendaftar.delete(id);
setItems((prev) => prev.filter((p) => p.id !== id));
} catch (e) {
alert("Gagal menghapus data: " + (e?.message || "error"));
}
};

