import React, { useState } from "react";
import { useNavigate } from "react-router-dom";
import { User, KeyRound, LogOut, Info, ShieldCheck } from "lucide-react";
import { base44 } from "@/api/base44Client";
import { useAuth } from "@/lib/AuthContext";
import { Button } from "@/components/ui/button";
import { NAMA_ORGANISASI, NAMA_SEKOLAH } from "@/lib/kir-constants";

export default function AdminPengaturan() {
const { user } = useAuth();
const navigate = useNavigate();
const [resetting, setResetting] = useState(false);
const [resetSent, setResetSent] = useState(false);

const handleLogout = () => {
base44.auth.logout("/admin/login");
};

const handleChangePassword = async () => {
if (!user?.email) {
navigate("/forgot-password");
return;
}
if (!window.confirm(`Email reset password akan dikirim ke ${user.email}. Lanjutkan?`)) return;
setResetting(true);
try {
await base44.auth.resetPasswordRequest(user.email);
setResetSent(true);
} catch (e) {
// Selalu tampilkan sukses generik (API menyembunyikan keberadaan email)
setResetSent(true);
} finally {
setResetting(false);
}
};

return (
<div className="space-y-5 max-w-3xl">
<div>
<h1 className="font-heading font-extrabold text-2xl text-kir-blue-dark">Pengaturan</h1>
<p className="text-sm text-muted-foreground mt-1">Profil admin, keamanan, dan informasi sistem.</p>
</div>

{/* Profil admin */}
<div className="rounded-2xl bg-white border border-border shadow-soft p-6">
<div className="flex items-center gap-2 mb-4">
<User className="h-5 w-5 text-kir-blue" />
<h2 className="font-heading font-bold text-base text-kir-blue-dark">Profil Admin</h2>
</div>
<dl className="space-y-3 text-sm">
<div className="flex justify-between">
<dt className="text-muted-foreground">Email</dt>
<dd className="font-semibold text-foreground">{user?.email || "—"}</dd>
</div>
<div className="flex justify-between">
<dt className="text-muted-foreground">Peran</dt>
<dd className="font-semibold text-foreground capitalize">{user?.role || "admin"}</dd>
</div>
<div className="flex justify-between">
<dt className="text-muted-foreground">Nama</dt>
<dd className="font-semibold text-foreground">{user?.full_name || "—"}</dd>
</div>
</dl>
</div>

{/* Keamanan */}
<div className="rounded-2xl bg-white border border-border shadow-soft p-6">
<div className="flex items-center gap-2 mb-4">
<ShieldCheck className="h-5 w-5 text-kir-red" />
<h2 className="font-heading font-bold text-base text-kir-blue-dark">Keamanan</h2>
</div>
<div className="flex flex-col sm:flex-row sm:items-center gap-3">
<Button variant="outline" onClick={handleChangePassword} disabled={resetting} className="border-kir-blue/40 text-kir-blue hover:bg-kir-blue/10">
<KeyRound className="h-4 w-4 mr-2" />
{resetting ? "Memproses..." : "Ganti Password"}
</Button>
{resetSent && (
<p className="text-sm text-green-600 font-semibold">
Tautan reset password telah dikirim ke email Anda (jika akun terdaftar).
</p>
)}
</div>
<p className="text-xs text-muted-foreground mt-3">
Ganti password dilakukan melalui email reset yang aman dari platform.
</p>
<div className="mt-5 pt-5 border-t border-border">
<Button variant="outline" onClick={handleLogout} className="text-destructive border-destructive/40 hover:bg-destructive/10">
<LogOut className="h-4 w-4 mr-2" /> Logout
</Button>
</div>
</div>

{/* Informasi sistem */}
<div className="rounded-2xl bg-white border border-border shadow-soft p-6">
<div className="flex items-center gap-2 mb-4">
<Info className="h-5 w-5 text-kir-blue" />
<h2 className="font-heading font-bold text-base text-kir-blue-dark">Informasi Sistem</h2>
</div>
<dl className="space-y-3 text-sm">
<div className="flex justify-between">
<dt className="text-muted-foreground">Nama Organisasi</dt>
<dd className="font-semibold text-foreground">{NAMA_ORGANISASI}</dd>
</div>
<div className="flex justify-between">
<dt className="text-muted-foreground">Sekolah</dt>
<dd className="font-semibold text-foreground">{NAMA_SEKOLAH}</dd>
</div>
<div className="flex justify-between">
<dt className="text-muted-foreground">Platform</dt>
<dd className="font-semibold text-foreground">Base44 (React + Backend bawaan)</dd>
</div>
<div className="flex justify-between">
<dt className="text-muted-foreground">Versi</dt>
<dd className="font-semibold text-foreground">1.0.0</dd>
</div>
</dl>
</div>
</div>
);
}
