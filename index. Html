return <div className="h-64 rounded-2xl bg-muted animate-pulse" />;
}

return (
<div className="space-y-5 max-w-3xl">
<div>
<h1 className="font-heading font-extrabold text-2xl text-kir-blue-dark">Informasi Website</h1>
<p className="text-sm text-muted-foreground mt-1">
Atur konten yang tampil pada website publik. Perubahan otomatis tersinkronisasi.
</p>
</div>

<form onSubmit={handleSave} className="rounded-2xl bg-white border border-border shadow-soft p-6 sm:p-8 space-y-5">
<div className="space-y-2">
<Label className="font-semibold">Judul Website</Label>
<Input
value={form.judul_website}
maxLength={100}
onChange={(e) => setForm({ ...form, judul_website: e.target.value })}
className="h-11"
/>
</div>
<div className="space-y-2">
<Label className="font-semibold">Deskripsi Hero (Beranda)</Label>
<Textarea
value={form.deskripsi_hero}
maxLength={600}
rows={4}
onChange={(e) => setForm({ ...form, deskripsi_hero: e.target.value })}
/>
</div>
<div className="space-y-2">
<Label className="font-semibold">Informasi Pendaftaran</Label>
<Textarea
value={form.info_pendaftaran}
maxLength={600}
rows={3}
onChange={(e) => setForm({ ...form, info_pendaftaran: e.target.value })}
/>
</div>
<div className="space-y-2">
<Label className="font-semibold">Informasi Kontak</Label>
<Textarea
value={form.info_kontak}
maxLength={600}
rows={3}
onChange={(e) => setForm({ ...form, info_kontak: e.target.value })}
/>
</div>
<div className="space-y-2">
<Label className="font-semibold">URL Instagram Resmi</Label>
<Input
type="url"
value={form.instagram}
maxLength={300}
onChange={(e) => setForm({ ...form, instagram: e.target.value })}
className="h-11"
/>
<p className="text-xs text-muted-foreground">Hanya Instagram. Jangan tambahkan email atau media sosial lain.</p>
</div>
<div className="space-y-2">
<Label className="font-semibold">Teks Footer</Label>
<Input
value={form.footer_text}
maxLength={300}
onChange={(e) => setForm({ ...form, footer_text: e.target.value })}
className="h-11"
/>
</div>

<div className="flex items-center gap-3 pt-2">
<Button type="submit" disabled={saving} className="btn-kir-gradient text-white">
{saving ? <Loader2 className="h-4 w-4 mr-2 animate-spin" /> : <Save className="h-4 w-4 mr-2" />}
{saving ? "Menyimpan..." : "Simpan Informasi"}
</Button>
{saved && (
<span className="inline-flex items-center gap-1.5 text-sm font-semibold text-green-600">
<CheckCircle2 className="h-4 w-4" /> Tersimpan
</span>
)}
</div>
</form>
</div>
);
}
