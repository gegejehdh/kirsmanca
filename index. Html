const [uploading, setUploading] = useState(false);

const load = () => {
setLoading(true);
base44.entities.Kegiatan.filter({}, { sort: "-tanggal_kegiatan", limit: 100 })
.then((p) => setItems(p.items || []))
.catch(() => setItems([]))
.finally(() => setLoading(false));
