if (!file) return;
setUploading(true);
try {
const { file_url } = await base44.integrations.Core.UploadPublicFile({ file });
setEditing((e) => ({ ...e, gambar: file_url }));
} catch (e) {
alert("Gagal mengunggah foto: " + (e?.message || "error"));
