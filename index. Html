import React, { useState, useEffect } from "react";
import { Upload, Trash2, Pencil, X, Loader2, Images, AlertTriangle, CheckCircle2 } from "lucide-react";
import { base44 } from "@/api/base44Client";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Image } from "@/components/ui/image";

async function computeSHA256(file) {
const buf = await file.arrayBuffer();
const hashBuf = await crypto.subtle.digest("SHA-256", buf);
return Array.from(new Uint8Array(hashBuf))
.map((b) => b.toString(16).padStart(2, "0"))
.join("");
}

export default function AdminDokumentasi() {
const [items, setItems] = useState([]);
const [loading, setLoading] = useState(true);
const [busy, setBusy] = useState(false); // upload+dedup
const [status, setStatus] = useState({ type: "", msg: "" });
const [editing, setEditing] = useState(null); // {id, keterangan}

const load = () => {
setLoading(true);
base44.entities.Dokumentasi.filter({}, { sort: "-created_date", limit: 200 })
.then((p) => setItems(p.items || []))
.catch(() => setItems([]))
.finally(() => setLoading(false));
};

useEffect(load, []);

const handleUpload = async (file) => {
if (!file) return;
setStatus({ type: "", msg: "" });
if (!file.type.startsWith("image/")) {
setStatus({ type: "error", msg: "File harus berupa gambar." });
return;
}
if (file.size > 8 * 1024 * 1024) {
setStatus({ type: "error", msg: "Ukuran file maksimal 8 MB." });
return;
}
setBusy(true);
try {
// 1. Hitung hash
const hash = await computeSHA256(file);
// 2. Cek duplikasi terhadap hash yang sudah tersimpan
const existing = await base44.entities.Dokumentasi.filter(
{ hash_file: hash },
{ limit: 1 }
);
if (existing.items && existing.items.length > 0) {
setStatus({ type: "error", msg: "Foto tersebut sudah tersedia dalam dokumentasi." });
return;
}
// 3. Unggah
const { file_url } = await base44.integrations.Core.UploadPublicFile({ file });
// 4. Simpan record
await base44.entities.Dokumentasi.create({
foto_url: file_url,
nama_file: file.name,
hash_file: hash,
keterangan: "",
});
setStatus({ type: "success", msg: "Foto berhasil diunggah ke dokumentasi." });
load();
} catch (e) {
setStatus({ type: "error", msg: "Gagal mengunggah: " + (e?.message || "error") });
} finally {
setBusy(false);
}
};

const handleSaveKeterangan = async () => {
if (!editing) return;
try {
await base44.entities.Dokumentasi.update(editing.id, { keterangan: editing.keterangan });
setEditing(null);
load();
} catch (e) {
alert("Gagal menyimpan: " + (e?.message || "error"));
}
};

const handleDelete = async (id) => {
if (!window.confirm("Hapus foto dokumentasi ini?")) return;
await base44.entities.Dokumentasi.delete(id);
load();
};

return (
<div className="space-y-5">
<div>
<h1 className="font-heading font-extrabold text-2xl text-kir-blue-dark">Dokumentasi</h1>
<p className="text-sm text-muted-foreground mt-1">
Unggah foto dokumentasi. Sistem mencegah foto identik (berdasarkan hash SHA-256).
</p>
</div>

{/* Upload area */}
<div className="rounded-2xl bg-white border border-border shadow-soft p-6">
<label className="flex flex-col items-center justify-center gap-3 border-2 border-dashed border-border rounded-xl py-10 cursor-pointer hover:bg-muted/40 transition-colors">
{busy ? (
<Loader2 className="h-10 w-10 text-kir-blue animate-spin" />
) : (
<Upload className="h-10 w-10 text-kir-blue" />
)}
<div className="text-center">
<p className="font-semibold text-foreground">
{busy ? "Memproses..." : "Klik untuk mengunggah foto dokumentasi"}
</p>
<p className="text-xs text-muted-foreground mt-1">Format gambar, maksimal 8 MB</p>
</div>
<input
type="file"
accept="image/*"
className="hidden"
onChange={(e) => handleUpload(e.target.files[0])}
disabled={busy}
/>
</label>

{status.msg && (
<div
className={`mt-4 flex items-start gap-2 rounded-lg p-3 text-sm ${
status.type === "error"
? "bg-destructive/10 text-destructive"
: "bg-green-50 text-green-700"
}`}
>
{status.type === "error" ? (
<AlertTriangle className="h-5 w-5 shrink-0" />
) : (
<CheckCircle2 className="h-5 w-5 shrink-0" />
)}
<span>{status.msg}</span>
</div>
)}
</div>

{/* Gallery */}
{loading ? (
<div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
{[0, 1, 2, 3].map((i) => (
<div key={i} className="aspect-square rounded-xl bg-muted animate-pulse" />
))}
</div>
) : items.length === 0 ? (
<div className="text-center py-16 rounded-2xl bg-white border border-dashed border-border">
<Images className="h-12 w-12 mx-auto text-muted-foreground/40 mb-3" />
<p className="text-muted-foreground">Belum ada dokumentasi.</p>
</div>
) : (
<div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
{items.map((it) => (
<div key={it.id} className="group relative aspect-square rounded-xl overflow-hidden border border-border shadow-soft">
<Image src={it.foto_url} alt={it.keterangan || it.nama_file} fittingType="fill" className="h-full w-full object-cover" />
<div className="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-3">
<p className="text-white text-xs line-clamp-2 mb-2">{it.keterangan || it.nama_file}</p>
<div className="flex gap-2">
<button
onClick={() => setEditing({ id: it.id, keterangan: it.keterangan || "" })}
className="flex-1 inline-flex items-center justify-center gap-1 rounded-md bg-white/90 px-2 py-1.5 text-xs font-semibold text-kir-blue-dark hover:bg-white"
>
<Pencil className="h-3 w-3" /> Keterangan
</button>
<button
onClick={() => handleDelete(it.id)}
className="inline-flex items-center justify-center rounded-md bg-red-500/90 px-2 py-1.5 text-xs font-semibold text-white hover:bg-red-500"
>
<Trash2 className="h-3 w-3" />
</button>
</div>
</div>
</div>
))}
</div>
)}

{/* Edit keterangan modal */}
{editing && (
<div className="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4" onClick={() => setEditing(null)}>
<div className="bg-white rounded-2xl shadow-card w-full max-w-md p-6" onClick={(e) => e.stopPropagation()}>
<div className="flex items-center justify-between mb-4">
<h2 className="font-heading font-bold text-lg text-kir-blue-dark">Edit Keterangan Foto</h2>
<button onClick={() => setEditing(null)} className="text-muted-foreground hover:text-foreground">
<X className="h-5 w-5" />
</button>
</div>
<div className="space-y-2">
<Label className="font-semibold">Keterangan</Label>
<Textarea
value={editing.keterangan}
maxLength={300}
rows={3}
onChange={(e) => setEditing({ ...editing, keterangan: e.target.value })}
placeholder="Tuliskan keterangan foto..."
/>
</div>
<div className="flex gap-3 mt-5">
<Button variant="outline" onClick={() => setEditing(null)} className="flex-1">Batal</Button>
<Button onClick={handleSaveKeterangan} className="flex-1 btn-kir-gradient text-white">Simpan</Button>
</div>
</div>
</div>
)}
</div>
);
}
